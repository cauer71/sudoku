// Cloudflare Workers mit statischen Assets — die für neue Projekte empfohlene
// Betriebsart (Pages ist der ältere Weg).
//
// Ausgeliefert wird dist/, nicht das Wurzelverzeichnis. dist/ stellt
// tools/collect.mjs aus einer Positivliste zusammen; damit kann nichts
// versehentlich mit veröffentlicht werden, und `wrangler dev` überwacht nicht
// das Verzeichnis, in das es selbst schreibt.
{
  "name": "sudoku",
  "compatibility_date": "2026-08-28",

  // Der Worker beantwortet nur /api/... — statische Dateien liefert die
  // Asset-Schicht direkt aus, ohne ihn aufzurufen.
  "main": "./worker/index.js",

  // Eine Datenbank für mehrere Spiele, nicht mehr eine je Spiel.
  //
  // D1 zählt im Free-Tarif Datenbanken — zehn sind das Limit —, nicht
  // Tabellen. Da hier etwa alle vier Tage ein neues Spiel entsteht, wäre das
  // Kontingent in Wochen aufgebraucht gewesen; Tabellen dagegen kosten nichts.
  // Also teilen sich die Spiele die Datenbank "spiele", und die Zugehörigkeit
  // steht im Tabellennamen: aus "best" wurde "sudoku_best".
  //
  // Der Präfix ist nicht Zierde, sondern löst zwei echte Kollisionen: zwei
  // Spiele hatten je eine Tabelle "zaehler" mit denselben Zeilen und hätten
  // einander hochgezählt, und Indexnamen sind in SQLite je DATENBANK eindeutig,
  // nicht je Tabelle — darum trägt auch der Index den Präfix.
  //
  // Das Binding heisst weiterhin DB: im Code steht nur env.DB, welche Datenbank
  // daran hängt, entscheidet allein diese Datei.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spiele",
      "database_id": "b82cb4dd-a307-4d2e-adb8-d20c98117ee2"
    }
  ],

  "assets": {
    "directory": "./dist",

    // Nötig, damit der Worker unbekannte Pfade an die Asset-Schicht
    // zurückgeben kann; die liefert dann 404.html.
    "binding": "ASSETS",

    // Die App hat nur eine Seite, also keine Client-Routen. Bewusst NICHT
    // "single-page-application": das liefert für jeden unbekannten Pfad
    // index.html mit Status 200 — auch für ein fehlendes Bild, das dann
    // stillschweigend HTML zurückbekommt. Mit "404-page" schlagen echte
    // Fehler sichtbar fehl und Besucher landen auf 404.html.
    "not_found_handling": "404-page",

    "html_handling": "auto-trailing-slash"
  },

  // Ratenbegrenzung für /api/scores. Die Rangliste hat keine Konten — wer die
  // Adresse kennt, kann senden. Prüfbar ist nur Form und Plausibilität, gegen
  // schieres Draufhalten hilft das nicht. Diese Schranke schon.
  //
  // Gezählt wird je Cloudflare-Standort, nicht weltweit, und die Periode darf
  // nur 10 oder 60 Sekunden sein — beides Vorgaben der Schnittstelle.
  // Schreiben ist knapper bemessen als Lesen: ein Rätsel dauert Minuten, die
  // Rangliste sieht man sich öfter an.
  "ratelimits": [
    {
      "name": "SCHREIB_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "LESE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "observability": { "enabled": true }
}
